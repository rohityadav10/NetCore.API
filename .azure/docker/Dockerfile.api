# syntax=docker/dockerfile:1.7
# NetCore.API image for the Azure DevOps pipeline (.azure/). Build context = repository root:
#   docker build -f .azure/docker/Dockerfile.api --build-arg APP_VERSION=20260928.1 -t netcore-api .
# The root ./Dockerfile belongs to the GitHub Actions workflows and is left unchanged.

ARG DOTNET_VERSION=8.0

# ── Stage 1: build with the SDK ──────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

# Restore first so the package layer is cached until the csproj changes.
COPY NetCore.API.csproj ./
RUN dotnet restore NetCore.API.csproj

COPY . .
# Same stamp as the IIS artifact: /api/AppStatus reports the pipeline build number.
ARG APP_VERSION=1.2.0
RUN dotnet publish NetCore.API.csproj --configuration Release --no-restore --output /app/publish \
      -p:InformationalVersion=${APP_VERSION} -p:UseAppHost=false

# ── Stage 2: runtime only — no SDK, no shell, no package manager ─────────────
# "Chiseled" Ubuntu images carry only what .NET needs: far fewer OS packages for
# Trivy to flag, and they run as the non-root 'app' user by default.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ARG APP_VERSION=1.2.0
LABEL org.opencontainers.image.title="netcore-api" \
      org.opencontainers.image.version="${APP_VERSION}"

USER $APP_UID
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
# No HEALTHCHECK: chiseled images have no curl/wget, and Container Apps ignores Docker
# HEALTHCHECK anyway. Liveness is GET /health — probed by Container Apps and by the
# pipeline's post-deploy check (.azure/scripts/deploy-containerapps.sh).
ENTRYPOINT ["dotnet", "NetCore.API.dll"]
